{
  "version": 2,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "lebonchantier.fr"
        }
      ],
      "destination": "https://trouvepro.fr/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.lebonchantier.fr"
        }
      ],
      "destination": "https://trouvepro.fr/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/annonces-locales/:category/:city",
      "destination": "/api/local-seo?category=:category&city=:city"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
